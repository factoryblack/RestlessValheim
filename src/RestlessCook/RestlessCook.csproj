<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>RestlessCook</AssemblyName>
    <RootNamespace>RestlessCook</RootNamespace>
    <Version>0.1.9</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\dist\</OutputPath>
    <DebugType>embedded</DebugType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JotunnLib" Version="$(JotunnLibVersion)" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\cook.yaml" LogicalName="RestlessCook.cook.yaml" />
    <EmbeddedResource Include="Assets\*.png" LogicalName="RestlessCook.Assets.%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    CookMesh.cs loads custom feast/meal models from a loose "mesh" folder next
    to the compiled DLL, or from the plugin directory itself when a manager
    (r2modman) flattens that folder. The Thunderstore package build
    (thunderstore/cook/thunderstore.toml) copies art/cook/runtime -> mesh/
    into the shipped zip, but a plain `dotnet build` only produces the DLL in
    OutputPath. Copying the same source here keeps a raw dist/ build
    self-sufficient instead of silently falling back to vanilla meshes.
  -->
  <Target Name="CopyCookMeshAssets" AfterTargets="Build">
    <ItemGroup>
      <CookMeshAssets Include="$(MSBuildThisFileDirectory)..\..\art\cook\runtime\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(CookMeshAssets)" DestinationFolder="$(OutputPath)mesh\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
