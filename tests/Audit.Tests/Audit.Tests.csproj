<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><AuditPython Condition="'$(AuditPython)' == ''">python3</AuditPython></PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/RestlessQoL/Storage/StorageAccess.cs" Link="StorageAccess.cs" />
    <Compile Include="../../src/RestlessQoL/Storage/ItemKey.cs" Link="ItemKey.cs" />
    <Compile Include="obj/AuditMethods.cs" />
  </ItemGroup>
  <Target Name="ExtractAuditMethods" BeforeTargets="CoreCompile">
    <Exec Command="&quot;$(AuditPython)&quot; &quot;$(MSBuildProjectDirectory)/extract.py&quot;" />
  </Target>
</Project>
